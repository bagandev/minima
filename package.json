{
  "name": "@bagandev/minima",
  "version": "0.1.1",
  "description": "Minimal theme for Bagan SSG",
  "type": "module",
  "types": "dist/index.d.mts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "susee build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagandev/minima.git"
  },
  "keywords": [
    "bagan",
    "theme"
  ],
  "bugs": {
    "url": "https://github.com/bagandev/minima/issues"
  },
  "homepage": "https://github.com/bagandev/minima#readme",
  "devDependencies": {
    "@bagandev/types": "^0.2.1",
    "susee": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bagan-alerts": "^0.1.2"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "_layouts/**/*",
    "_includes/**/*",
    "_assets/**/*",
    "_data/**/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
